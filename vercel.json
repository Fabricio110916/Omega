{
  "version": 2,
  "regions": ["gru1"],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Connection", "value": "Upgrade" },
        { "key": "Upgrade", "value": "websocket" }
      ]
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "https://my.koom.pp.ua/$1"
    }
  ]
}
